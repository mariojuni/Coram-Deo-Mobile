platform :android do
  desc "Build and upload staging to Firebase App Distribution"
  lane :staging do
    gradle(
      project_dir: "android",
      task: "assemble",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => File.expand_path("staging-upload-key.keystore", __dir__),
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
      }
    )

    android_firebase_opts = {
      app: ENV["FIREBASE_ANDROID_APP_ID_STAGING"],
      service_credentials_file: "fastlane/service-account.json",
      release_notes: "Built from GitHub Actions (Commit: #{ENV['GITHUB_SHA']})"
    }
    android_firebase_opts[:groups] = ENV["FIREBASE_TESTER_GROUPS"] if ENV["FIREBASE_TESTER_GROUPS"] && !ENV["FIREBASE_TESTER_GROUPS"].empty?
    firebase_app_distribution(android_firebase_opts)
  end

  desc "Build and upload production to Google Play"
  lane :production do
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => File.expand_path("upload-key.keystore", __dir__),
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
      }
    )

    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: "fastlane/play-service-account.json",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Build and upload staging to Firebase App Distribution"
  lane :staging do
    setup_ci
    
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house: false
    )

    match(
      type: "adhoc",
      app_identifier: "com.coramdeo.app.staging",
      readonly: ENV["CI"] ? true : false
    )

    scheme_name = "CoramDeoDEV"
    team_id = lane_context[:MATCH_TEAM_ID] || lane_context[:SIGH_TEAM] || ENV["APPLE_TEAM_ID"] || "267GZU5SHN"

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"],
      xcodeproj: "ios/#{scheme_name}.xcodeproj"
    )

    signing_opts = {
      use_automatic_signing: false,
      path: "ios/#{scheme_name}.xcodeproj",
      profile_name: lane_context[:MATCH_PROVISIONING_PROFILE_MAPPING]["com.coramdeo.app.staging"],
      code_sign_identity: "Apple Distribution"
    }
    signing_opts[:team_id] = team_id if team_id && !team_id.to_s.empty?
    update_code_signing_settings(signing_opts)

    gym_opts = {
      workspace: "ios/#{scheme_name}.xcworkspace",
      scheme: scheme_name,
      export_method: "ad-hoc",
      clean: true,
      export_options: {
        method: "ad-hoc",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.coramdeo.app.staging" => lane_context[:MATCH_PROVISIONING_PROFILE_MAPPING]["com.coramdeo.app.staging"]
        }
      }
    }
    gym_opts[:xcargs] = "DEVELOPMENT_TEAM=#{team_id}" if team_id && !team_id.to_s.empty?

    gym(gym_opts)

    ios_firebase_opts = {
      app: ENV["FIREBASE_IOS_APP_ID_STAGING"],
      service_credentials_file: "fastlane/service-account.json",
      release_notes: "Built from GitHub Actions (Commit: #{ENV['GITHUB_SHA']})"
    }
    ios_firebase_opts[:groups] = ENV["FIREBASE_TESTER_GROUPS"] if ENV["FIREBASE_TESTER_GROUPS"] && !ENV["FIREBASE_TESTER_GROUPS"].empty?
    firebase_app_distribution(ios_firebase_opts)
  end

  desc "Build and upload production to TestFlight/App Store"
  lane :production do
    setup_ci
    
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    match(
      type: "appstore",
      app_identifier: "com.coramdeo.app.prod",
      readonly: false
    )

    scheme_name = "CoramDeo"
    team_id = lane_context[:MATCH_TEAM_ID] || lane_context[:SIGH_TEAM] || ENV["APPLE_TEAM_ID"] || "267GZU5SHN"

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"],
      xcodeproj: "ios/#{scheme_name}.xcodeproj"
    )

    signing_opts = {
      use_automatic_signing: false,
      path: "ios/#{scheme_name}.xcodeproj",
      profile_name: lane_context[:MATCH_PROVISIONING_PROFILE_MAPPING]["com.coramdeo.app.prod"],
      code_sign_identity: "Apple Distribution"
    }
    signing_opts[:team_id] = team_id if team_id && !team_id.to_s.empty?
    update_code_signing_settings(signing_opts)

    gym_opts = {
      workspace: "ios/#{scheme_name}.xcworkspace",
      scheme: scheme_name,
      export_method: "app-store",
      clean: true,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.coramdeo.app.prod" => lane_context[:MATCH_PROVISIONING_PROFILE_MAPPING]["com.coramdeo.app.prod"]
        }
      }
    }
    gym_opts[:xcargs] = "DEVELOPMENT_TEAM=#{team_id}" if team_id && !team_id.to_s.empty?

    gym(gym_opts)

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
