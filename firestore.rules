rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /**
     * Fetch the current user's document once and return it.
     * Using a helper keeps get() calls DRY and avoids quota issues.
     */
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    /**
     * Multi-role check: returns true if the user's systemRoles array contains
     * any of the provided roles.  Falls back to the legacy `role` string for
     * documents that have not yet been migrated.
     */
    function hasAnySystemRole(roles) {
      let ud = userDoc();
      return (
        ('systemRoles' in ud && ud.systemRoles != null && ud.systemRoles.hasAny(roles)) ||
        ('role' in ud && ud.role in roles)
      );
    }

    function isSuperAdmin() {
      return userDocExists() && hasAnySystemRole(['super_admin']);
    }

    function isRoleAdmin(churchId) {
      return isSuperAdmin() || (
        userDocExists() &&
        userDoc().churchId == churchId &&
        hasAnySystemRole(['church_admin'])
      );
    }

    function isPastorOrAdmin(churchId) {
      return isSuperAdmin() || (
        userDocExists() &&
        userDoc().churchId == churchId &&
        hasAnySystemRole(['church_admin', 'pastor'])
      );
    }

    function isChurchAdmin(churchId) {
      return isSuperAdmin() || (
        userDocExists() &&
        userDoc().churchId == churchId &&
        hasAnySystemRole(['church_admin', 'ministry_leader'])
      );
    }

    function isFinanceOrChurchAdmin(churchId) {
      return isSuperAdmin() || (
        userDocExists() &&
        userDoc().churchId == churchId &&
        hasAnySystemRole(['church_admin', 'finance_admin'])
      );
    }

    /**
     * A ministry_leader can manage a specific ministry only if that ministryId
     * is listed in their managedMinistryIds array.
     */
    function isAssignedMinistryLeader(churchId, ministryId) {
      return isSignedIn() &&
        userDocExists() &&
        userDoc().churchId == churchId &&
        hasAnySystemRole(['ministry_leader']) &&
        userDoc().managedMinistryIds != null &&
        userDoc().managedMinistryIds.hasAll([ministryId]);
    }

    function isWorshipAdmin(churchId, ministryId) {
      return isPastorOrAdmin(churchId) || 
             (ministryId != null && isAssignedMinistryLeader(churchId, ministryId));
    }

    function canReadWorship(churchId, ministryId) {
      if (isPastorOrAdmin(churchId)) return true;
      if (ministryId != null && userDocExists() && userDoc().memberId != null) {
        let minDoc = get(/databases/$(database)/documents/ministries/$(ministryId));
        if (minDoc != null) {
          return minDoc.data.churchId == churchId && 
                 minDoc.data.features.worshipTabEnabled == true &&
                 minDoc.data.memberIds != null && 
                 minDoc.data.memberIds.hasAny([userDoc().memberId]);
        }
      }
      // Fallback for church-wide worship items without a specific ministryId,
      // or if we can't easily query all ministries for the user in rules.
      return isSignedIn() && userDocExists() && userDoc().churchId == churchId;
    }

    // ── ministryApplications ─────────────────────────────────────────────────
    match /ministryApplications/{applicationId} {

      // Any signed-in user (including admins/ministry leaders) can submit an
      // application for their own userId/memberId/churchId.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.churchId != null
        && request.resource.data.memberId != null
        && request.resource.data.status == 'pending';

      // Applicant can read their own; admins can read all in their church.
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || isChurchAdmin(resource.data.churchId));

      // Applicant can withdraw their own pending application.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.userId == request.auth.uid;

      // Admin/ministry leader can approve or decline — but NOT their own application
      // (prevents self-approval even when the applicant is an admin).
      allow update: if isChurchAdmin(resource.data.churchId)
        && resource.data.userId != request.auth.uid;

      // No deletes by clients.
      allow delete: if false;
    }

    // ── ministries ───────────────────────────────────────────────────────────
    match /ministries/{ministryId} {
      allow read: if isSignedIn()
        && resource.data.churchId != null;

      allow create: if isPastorOrAdmin(request.resource.data.churchId);

      allow update: if isPastorOrAdmin(resource.data.churchId) ||
        isAssignedMinistryLeader(resource.data.churchId, ministryId);

      allow delete: if isPastorOrAdmin(resource.data.churchId);
    }

    // ── ministryAssignments ──────────────────────────────────────────────────
    match /ministryAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isChurchAdmin(resource.data.churchId);
    }

    // ── Giving ───────────────────────────────────────────────────────────────
    match /givingFunds/{fundId} {
      allow read: if isSignedIn();
      allow write: if isFinanceOrChurchAdmin(request.resource.data.churchId) || isFinanceOrChurchAdmin(resource.data.churchId);
    }

    match /givingCampaigns/{campaignId} {
      allow read: if isSignedIn() && (resource == null || resource.data.churchId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId);
      allow write: if isFinanceOrChurchAdmin(request.resource.data.churchId) && (resource == null || isFinanceOrChurchAdmin(resource.data.churchId));
    }

    match /paymentMethods/{methodId} {
      allow read: if isSignedIn();
      allow write: if isFinanceOrChurchAdmin(request.resource.data.churchId) || isFinanceOrChurchAdmin(resource.data.churchId);
    }

    match /givingRecords/{recordId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isFinanceOrChurchAdmin(resource.data.churchId));

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.churchId != null;

      allow update, delete: if isFinanceOrChurchAdmin(resource.data.churchId);
    }

    match /givingExpenses/{expenseId} {
      allow read: if isSignedIn() && (resource.data.visibility == 'public_summary' || isFinanceOrChurchAdmin(resource.data.churchId));
      allow write: if isFinanceOrChurchAdmin(request.resource.data.churchId) || isFinanceOrChurchAdmin(resource.data.churchId);
    }

    // ── Worship Library ──────────────────────────────────────────────────────
    match /songs/{songId} {
      allow read: if canReadWorship(resource.data.churchId, resource.data.get('ministryId', null));
      allow write: if isWorshipAdmin(request.resource.data.churchId, request.resource.data.get('ministryId', null)) || 
                      isWorshipAdmin(resource.data.churchId, resource.data.get('ministryId', null));
    }

    match /songVersions/{versionId} {
      allow read: if canReadWorship(resource.data.churchId, resource.data.get('ministryId', null));
      allow write: if isWorshipAdmin(request.resource.data.churchId, request.resource.data.get('ministryId', null)) || 
                      isWorshipAdmin(resource.data.churchId, resource.data.get('ministryId', null));
    }

    match /worshipSetlists/{setlistId} {
      allow read: if canReadWorship(resource.data.churchId, resource.data.get('ministryId', null));
      allow write: if isWorshipAdmin(request.resource.data.churchId, request.resource.data.get('ministryId', null)) || 
                      isWorshipAdmin(resource.data.churchId, resource.data.get('ministryId', null));

      match /worshipSetlistItems/{itemId} {
        allow read: if canReadWorship(get(/databases/$(database)/documents/worshipSetlists/$(setlistId)).data.churchId, get(/databases/$(database)/documents/worshipSetlists/$(setlistId)).data.get('ministryId', null));
        allow write: if isWorshipAdmin(get(/databases/$(database)/documents/worshipSetlists/$(setlistId)).data.churchId, get(/databases/$(database)/documents/worshipSetlists/$(setlistId)).data.get('ministryId', null));
      }
    }

    match /worshipSetlistItems/{itemId} {
      allow read: if canReadWorship(resource.data.churchId, resource.data.get('ministryId', null));
      allow write: if isWorshipAdmin(request.resource.data.churchId, request.resource.data.get('ministryId', null)) || 
                      isWorshipAdmin(resource.data.churchId, resource.data.get('ministryId', null));
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn();

      // Owner can update their own doc but may NOT change their own roles or churchId.
      // super_admin can update anyone else's doc.
      // church_admin/role-admin can update docs within their church (but cannot grant super_admin).
      allow update: if isSignedIn() && (
        // Owner self-update: must not change systemRoles, primaryRole, role, or churchId.
        (isOwner(userId) &&
          request.resource.data.systemRoles == resource.data.systemRoles &&
          request.resource.data.primaryRole == resource.data.primaryRole &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.churchId == resource.data.churchId) ||

        // super_admin can update any other user.
        (isSuperAdmin() && request.auth.uid != userId) ||

        // church_admin / role-admin can update users within their church,
        // but cannot elevate to super_admin.
        (isRoleAdmin(resource.data.churchId) &&
          request.resource.data.churchId == resource.data.churchId &&
          !(request.resource.data.systemRoles != null && request.resource.data.systemRoles.hasAll(['super_admin'])) &&
          request.resource.data.role != 'super_admin' &&
          request.auth.uid != userId)
      );

      allow delete: if isSuperAdmin();

      // ── Bible preferences / highlights (per-user) ──────────────────────────
      match /bible/{docId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }

    // ── Role Audit Logs ──────────────────────────────────────────────────────
    match /roleAuditLogs/{logId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isRoleAdmin(resource.data.churchId));
      allow create: if isSignedIn();
    }

    // ── Events (church schedules / RSVP) ────────────────────────────────────
    match /events/{eventId} {
      allow read: if isSignedIn();
      // RSVPs can be updated by any signed-in member; creation/deletion by admins.
      allow update: if isSignedIn();
      allow create, delete: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    // ── Churches (top-level doc + subcollections) ────────────────────────────
    match /churches/{churchId} {
      allow read: if isSignedIn();
      allow write: if isRoleAdmin(churchId);

      // Prayer requests subcollection
      match /prayer_requests/{requestId} {
        allow read: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.visibility == 'public' ||
          isPastorOrAdmin(churchId)
        );
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isPastorOrAdmin(churchId)
        );
        allow delete: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isPastorOrAdmin(churchId)
        );
      }

      // Bible plans subcollection (church-scoped)
      match /bible_plans/{planId} {
        allow read: if isSignedIn();
        allow write: if isRoleAdmin(churchId);
      }

      // User Bible Plans (per-user progress)
      match /userBiblePlans/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      match /biblePlanProgress/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // ── Sermons ──────────────────────────────────────────────────────────────
    match /sermons/{sermonId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    match /sermon_notes/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /sermon_favorites/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /sermon_downloads/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /sermon_progress/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ── Attendance ───────────────────────────────────────────────────────────
    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isPastorOrAdmin(resource.data.churchId);
    }

    // ── Services ─────────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    // ── Discipleship ─────────────────────────────────────────────────────────
    match /discipleshipPlans/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    match /discipleshipWeeks/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    match /discipleshipProgress/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
