rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /**
     * Fetch the current user's document once and return it.
     * Using a helper keeps get() calls DRY and avoids quota issues.
     */
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    /**
     * Multi-role check: returns true if the user's systemRoles array contains
     * any of the provided roles.  Falls back to the legacy `role` string for
     * documents that have not yet been migrated.
     */
    function hasAnySystemRole(roles) {
      let ud = userDoc();
      return (
        ('systemRoles' in ud && ud.systemRoles != null && ud.systemRoles.hasAny(roles)) ||
        ('role' in ud && ud.role in roles)
      );
    }

    function isSuperAdmin() {
      return userDocExists() && hasAnySystemRole(['super_admin']);
    }

    function isRoleAdmin(churchId) {
      return isSuperAdmin() || (
        userDocExists() &&
        userDoc().churchId == churchId &&
        hasAnySystemRole(['church_admin'])
      );
    }

    function isPastorOrAdmin(churchId) {
      return isSuperAdmin() || (
        userDocExists() &&
        userDoc().churchId == churchId &&
        hasAnySystemRole(['church_admin', 'pastor'])
      );
    }

    function isChurchAdmin(churchId) {
      return isSuperAdmin() || (
        userDocExists() &&
        userDoc().churchId == churchId &&
        hasAnySystemRole(['church_admin', 'ministry_leader', 'pastor', 'staff'])
      );
    }

    function isFinanceOrChurchAdmin(churchId) {
      return isSuperAdmin() || (
        userDocExists() &&
        userDoc().churchId == churchId &&
        hasAnySystemRole(['church_admin', 'finance_admin'])
      );
    }

    /**
     * A ministry_leader can manage a specific ministry only if that ministryId
     * is listed in their managedMinistryIds array.
     */
    function isAssignedMinistryLeader(churchId, ministryId) {
      return isSignedIn() &&
        userDocExists() &&
        userDoc().churchId == churchId &&
        hasAnySystemRole(['ministry_leader']) &&
        userDoc().managedMinistryIds != null &&
        userDoc().managedMinistryIds.hasAll([ministryId]);
    }

    function isWorshipAdmin(churchId, ministryId) {
      return isPastorOrAdmin(churchId) || 
             (ministryId != null && isAssignedMinistryLeader(churchId, ministryId));
    }

    function canReadWorship(churchId, ministryId) {
      return isSignedIn();
    }

    // ── ministryApplications ─────────────────────────────────────────────────
    match /ministryApplications/{applicationId} {

      // Any signed-in user can submit an application for their own userId/memberId/churchId.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.churchId != null
        && request.resource.data.memberId != null
        && request.resource.data.status == 'pending';

      // Applicant can read their own; full admins (super_admin, church_admin, pastor) can read all in their church.
      // Ministry leaders can read applications for ministries in their managedMinistryIds.
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || isPastorOrAdmin(resource.data.churchId)
            || isAssignedMinistryLeader(resource.data.churchId, resource.data.ministryId));

      // Applicant can withdraw their own pending application.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.userId == request.auth.uid;

      // Admin/ministry leader can approve or decline
      allow update: if isPastorOrAdmin(resource.data.churchId)
        || (isAssignedMinistryLeader(resource.data.churchId, resource.data.ministryId)
            && resource.data.userId != request.auth.uid);

      // No deletes by clients.
      allow delete: if false;
    }

    // ── Members ──────────────────────────────────────────────────────────────
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && (isPastorOrAdmin(resource.data.churchId)
            || isChurchAdmin(resource.data.churchId)
            || (userDocExists() && userDoc().churchId == resource.data.churchId)
            || (resource != null && resource.data.userId == request.auth.uid)
            || (request.resource != null && request.resource.data.userId == request.auth.uid));
    }

    // ── ministryMembers ──────────────────────────────────────────────────────
    match /ministryMembers/{memberDocId} {
      allow read: if isSignedIn();

      allow write: if isPastorOrAdmin(request.resource.data.churchId)
        || isAssignedMinistryLeader(request.resource.data.churchId, request.resource.data.ministryId);
    }

    // ── ministries ───────────────────────────────────────────────────────────
    match /ministries/{ministryId} {
      allow read: if isSignedIn()
        && resource.data.churchId != null;

      allow create: if isPastorOrAdmin(request.resource.data.churchId);

      allow update: if isPastorOrAdmin(resource.data.churchId) ||
        isAssignedMinistryLeader(resource.data.churchId, ministryId);

      allow delete: if isPastorOrAdmin(resource.data.churchId);
    }

    // ── ministryAssignments ──────────────────────────────────────────────────
    match /ministryAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isChurchAdmin(request.resource.data.churchId);
      allow update: if isChurchAdmin(resource.data.churchId) || isChurchAdmin(request.resource.data.churchId) || (resource != null && resource.data.memberId == request.auth.uid);
      allow delete: if isChurchAdmin(resource.data.churchId);
    }

    // ── Giving ───────────────────────────────────────────────────────────────
    match /givingFunds/{fundId} {
      allow read: if isSignedIn();
      allow write: if isFinanceOrChurchAdmin(request.resource.data.churchId) || isFinanceOrChurchAdmin(resource.data.churchId);
    }

    match /givingCampaigns/{campaignId} {
      allow read: if isSignedIn() && (resource == null || resource.data.churchId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId);
      allow write: if isFinanceOrChurchAdmin(request.resource.data.churchId) && (resource == null || isFinanceOrChurchAdmin(resource.data.churchId));
    }

    match /paymentMethods/{methodId} {
      allow read: if isSignedIn();
      allow write: if isFinanceOrChurchAdmin(request.resource.data.churchId) || isFinanceOrChurchAdmin(resource.data.churchId);
    }

    match /givingRecords/{recordId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isFinanceOrChurchAdmin(resource.data.churchId));

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.churchId != null;

      allow update, delete: if isFinanceOrChurchAdmin(resource.data.churchId);
    }

    match /givingExpenses/{expenseId} {
      allow read: if isSignedIn() && (resource.data.visibility == 'public_summary' || isFinanceOrChurchAdmin(resource.data.churchId));
      allow write: if isFinanceOrChurchAdmin(request.resource.data.churchId) || isFinanceOrChurchAdmin(resource.data.churchId);
    }

    // ── Worship Library ──────────────────────────────────────────────────────
    match /songs/{songId} {
      allow read: if canReadWorship(resource.data.churchId, resource.data.get('ministryId', null));
      allow write: if isWorshipAdmin(request.resource.data.churchId, request.resource.data.get('ministryId', null)) || 
                      isWorshipAdmin(resource.data.churchId, resource.data.get('ministryId', null));
    }

    match /songVersions/{versionId} {
      allow read: if canReadWorship(resource.data.churchId, resource.data.get('ministryId', null));
      allow write: if isWorshipAdmin(request.resource.data.churchId, request.resource.data.get('ministryId', null)) || 
                      isWorshipAdmin(resource.data.churchId, resource.data.get('ministryId', null));
    }

    match /worshipSetlists/{setlistId} {
      allow read: if canReadWorship(resource.data.churchId, resource.data.get('ministryId', null));
      allow write: if isWorshipAdmin(request.resource.data.churchId, request.resource.data.get('ministryId', null)) || 
                      isWorshipAdmin(resource.data.churchId, resource.data.get('ministryId', null));

      match /worshipSetlistItems/{itemId} {
        allow read: if canReadWorship(get(/databases/$(database)/documents/worshipSetlists/$(setlistId)).data.churchId, get(/databases/$(database)/documents/worshipSetlists/$(setlistId)).data.get('ministryId', null));
        allow write: if isWorshipAdmin(get(/databases/$(database)/documents/worshipSetlists/$(setlistId)).data.churchId, get(/databases/$(database)/documents/worshipSetlists/$(setlistId)).data.get('ministryId', null));
      }
    }

    match /worshipSetlistItems/{itemId} {
      allow read: if canReadWorship(resource.data.churchId, resource.data.get('ministryId', null));
      allow write: if isWorshipAdmin(request.resource.data.churchId, request.resource.data.get('ministryId', null)) || 
                      isWorshipAdmin(resource.data.churchId, resource.data.get('ministryId', null));
    }

    match /personalWorshipArrangements/{arrangementId} {
      allow read, write: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid || resource.data.memberId == userDoc().memberId)
        && (request.resource == null || request.resource.data.userId == request.auth.uid || request.resource.data.memberId == userDoc().memberId)
        && (request.resource == null || request.resource.data.churchId == userDoc().churchId);
    }


    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;

      allow create: if isSignedIn();

      // Owner can update their own doc but may NOT change their own roles or churchId.
      // super_admin can update anyone else's doc.
      // church_admin/role-admin can update docs within their church (but cannot grant super_admin).
      allow update: if isSignedIn() && (
        // Owner self-update or updating linked member doc: must not change roles or churchId.
        ((isOwner(userId) || (resource.data.get('accountId', null) == request.auth.uid || resource.data.get('authUid', null) == request.auth.uid)) &&
          request.resource.data.get('systemRoles', null) == resource.data.get('systemRoles', null) &&
          request.resource.data.get('primaryRole', null) == resource.data.get('primaryRole', null) &&
          request.resource.data.get('role', null) == resource.data.get('role', null) &&
          request.resource.data.get('churchId', null) == resource.data.get('churchId', null) &&
          request.resource.data.get('status', null) == resource.data.get('status', null) &&
          request.resource.data.get('memberId', null) == resource.data.get('memberId', null)) ||

        // Allow unlinked member document account linking during registration:
        // Allows a newly authenticated user to bind their authUid/accountId to an unlinked imported member document.
        ((resource.data.get('authUid', null) == null || resource.data.get('authUid', null) == '') &&
          (request.resource.data.get('authUid', null) == request.auth.uid || request.resource.data.get('accountId', null) == request.auth.uid) &&
          request.resource.data.get('systemRoles', null) == resource.data.get('systemRoles', null) &&
          request.resource.data.get('primaryRole', null) == resource.data.get('primaryRole', null) &&
          request.resource.data.get('role', null) == resource.data.get('role', null)) ||

        // super_admin can update any other user.
        (isSuperAdmin() && request.auth.uid != userId) ||

        // church_admin / role-admin can update users within their church,
        // but cannot elevate to super_admin.
        (isRoleAdmin(resource.data.churchId) &&
          request.resource.data.churchId == resource.data.churchId &&
          !(request.resource.data.systemRoles != null && request.resource.data.systemRoles.hasAll(['super_admin'])) &&
          request.resource.data.role != 'super_admin' &&
          request.auth.uid != userId)
      );

      allow delete: if isSuperAdmin();

      // ── Bible preferences / highlights (per-user) ──────────────────────────
      match /bible/{docId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }

    // ── Comments ─────────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUserId == request.auth.uid;
      // Allow the comment author to update/delete, or allow a pastor/admin of the church to moderate
      allow update, delete: if isSignedIn() && (
        resource.data.authorUserId == request.auth.uid ||
        isPastorOrAdmin(resource.data.churchId)
      );
    }

    // ── Role Audit Logs ──────────────────────────────────────────────────────
    match /roleAuditLogs/{logId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isRoleAdmin(resource.data.churchId));
      allow create: if isSignedIn();
    }

    // ── Events (church schedules / RSVP) ────────────────────────────────────
    match /events/{eventId} {
      allow read: if isSignedIn();
      // RSVPs can be updated by any signed-in member; creation/deletion by admins.
      allow update: if isSignedIn();
      allow create, delete: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    // ── Churches (top-level doc + subcollections) ────────────────────────────
    match /churches/{churchId} {
      allow read: if isSignedIn();
      allow write: if isRoleAdmin(churchId);

      // Prayer requests subcollection
      match /prayer_requests/{requestId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isPastorOrAdmin(churchId) ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'likedBy', 'prayedCount', 'commentCount', 'updatedAt'])
        );
        allow delete: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isPastorOrAdmin(churchId)
        );
      }

      // Bible plans subcollection (church-scoped)
      match /bible_plans/{planId} {
        allow read: if isSignedIn();
        allow write: if isRoleAdmin(churchId);
      }

      // User Bible Plans (per-user progress)
      match /userBiblePlans/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      match /biblePlanProgress/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // ── Sermons ──────────────────────────────────────────────────────────────
    match /sermons/{sermonId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    match /sermon_notes/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /sermon_favorites/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /sermon_downloads/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /sermon_progress/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ── Attendance ───────────────────────────────────────────────────────────
    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isPastorOrAdmin(resource.data.churchId);
    }

    match /attendance_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);

      match /records/{recordId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── Services ─────────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    // ── Discipleship ─────────────────────────────────────────────────────────
    match /discipleshipPlans/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    match /discipleshipWeeks/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    match /discipleshipLessons/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }

    match /discipleshipProgress/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /discipleshipGroupPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.authorUserId == request.auth.uid || request.resource.data.authorMemberId != null);
      allow update, delete: if isSignedIn() && (
        resource.data.authorUserId == request.auth.uid ||
        isPastorOrAdmin(resource.data.churchId)
      );
    }

    // ── Discipleship Groups & Leader Materials ─────────────────────────────
    match /discipleshipGroups/{groupId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (
        isPastorOrAdmin(request.resource.data.churchId != null ? request.resource.data.churchId : resource.data.churchId) ||
        (resource != null && (
          (resource.data.leaderMemberIds != null && userDocExists() && userDoc().memberId != null && resource.data.leaderMemberIds.hasAny([userDoc().memberId])) ||
          (resource.data.leaderUserIds != null && resource.data.leaderUserIds.hasAny([request.auth.uid]))
        ))
      );
    }

    match /discipleshipGroupMaterials/{materialId} {
      allow read: if isSignedIn() && (
        resource.data.audience != 'leaders_only' ||
        isPastorOrAdmin(resource.data.churchId) ||
        (resource.data.groupId != null && exists(/databases/$(database)/documents/discipleshipGroups/$(resource.data.groupId)) && (
          (get(/databases/$(database)/documents/discipleshipGroups/$(resource.data.groupId)).data.leaderMemberIds != null &&
           userDocExists() && userDoc().memberId != null &&
           get(/databases/$(database)/documents/discipleshipGroups/$(resource.data.groupId)).data.leaderMemberIds.hasAny([userDoc().memberId])) ||
          (get(/databases/$(database)/documents/discipleshipGroups/$(resource.data.groupId)).data.leaderUserIds != null &&
           get(/databases/$(database)/documents/discipleshipGroups/$(resource.data.groupId)).data.leaderUserIds.hasAny([request.auth.uid]))
        ))
      );
      allow create, update, delete: if isSignedIn() && isPastorOrAdmin(request.resource.data.churchId != null
        ? request.resource.data.churchId
        : resource.data.churchId);
    }
  }
}
