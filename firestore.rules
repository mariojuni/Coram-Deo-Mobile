rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isRoleAdmin(churchId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'church_admin'];
    }

    function isPastorOrAdmin(churchId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'church_admin', 'pastor'];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isChurchAdmin(churchId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'church_admin', 'ministry_leader'];
    }

    function isFinanceOrChurchAdmin(churchId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'church_admin', 'finance_admin'];
    }

    // ── ministryApplications ─────────────────────────────────────────────────
    match /ministryApplications/{applicationId} {

      // Any signed-in user (including admins/ministry leaders) can submit an
      // application for their own userId/memberId/churchId.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.churchId != null
        && request.resource.data.memberId != null
        && request.resource.data.status == 'pending';

      // Applicant can read their own; admins can read all in their church.
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || isChurchAdmin(resource.data.churchId));

      // Applicant can withdraw their own pending application.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.userId == request.auth.uid;

      // Admin/ministry leader can approve or decline — but NOT their own application
      // (prevents self-approval even when the applicant is an admin).
      allow update: if isChurchAdmin(resource.data.churchId)
        && resource.data.userId != request.auth.uid;

      // No deletes by clients.
      allow delete: if false;
    }

    // ── ministries ───────────────────────────────────────────────────────────
    match /ministries/{ministryId} {
      allow read: if isSignedIn()
        && resource.data.churchId != null;

      allow create: if isPastorOrAdmin(request.resource.data.churchId);
      
      allow update: if isPastorOrAdmin(resource.data.churchId) || 
        (
          isSignedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == resource.data.churchId &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ministry_leader' &&
          (resource.data.leaderIds != null && request.auth.uid in resource.data.leaderIds)
        );

      allow delete: if isPastorOrAdmin(resource.data.churchId);
    }

    // ── ministryAssignments ──────────────────────────────────────────────────
    match /ministryAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isChurchAdmin(resource.data.churchId);
    }
    // ── Giving ───────────────────────────────────────────────────────────────
    match /givingFunds/{fundId} {
      allow read: if isSignedIn();
      allow write: if isChurchAdmin(request.resource.data.churchId) || isChurchAdmin(resource.data.churchId);
    }
    
    match /givingCampaigns/{campaignId} {
      allow read: if isSignedIn() && (resource == null || resource.data.churchId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId);
      allow write: if isFinanceOrChurchAdmin(request.resource.data.churchId) && (resource == null || isFinanceOrChurchAdmin(resource.data.churchId));
    }
    
    match /paymentMethods/{methodId} {
      allow read: if isSignedIn();
      allow write: if isChurchAdmin(request.resource.data.churchId) || isChurchAdmin(resource.data.churchId);
    }
    
    match /givingRecords/{recordId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isChurchAdmin(resource.data.churchId));
      
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.churchId != null;
        
      allow update, delete: if isChurchAdmin(resource.data.churchId);
    }
    
    match /givingExpenses/{expenseId} {
      allow read: if isSignedIn() && (resource.data.visibility == 'public_summary' || isChurchAdmin(resource.data.churchId));
      allow write: if isChurchAdmin(request.resource.data.churchId) || isChurchAdmin(resource.data.churchId);
    }

    // ── Worship Library ──────────────────────────────────────────────────────
    match /songs/{songId} {
      allow read: if isSignedIn();
      allow write: if isChurchAdmin(request.resource.data.churchId) || isChurchAdmin(resource.data.churchId);
    }
    
    match /songVersions/{versionId} {
      allow read: if isSignedIn();
      allow write: if isChurchAdmin(request.resource.data.churchId) || isChurchAdmin(resource.data.churchId);
    }

    match /worshipSetlists/{setlistId} {
      allow read: if isSignedIn();
      allow write: if isChurchAdmin(request.resource.data.churchId) || isChurchAdmin(resource.data.churchId);
      
      match /worshipSetlistItems/{itemId} {
        allow read: if isSignedIn();
        allow write: if isChurchAdmin(request.resource.data.churchId) || isChurchAdmin(resource.data.churchId);
      }
    }
    
    match /worshipSetlistItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isChurchAdmin(request.resource.data.churchId) || isChurchAdmin(resource.data.churchId);
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        (isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.churchId == resource.data.churchId) ||
        (isSuperAdmin() && request.auth.uid != userId) ||
        (
          isRoleAdmin(resource.data.churchId) && 
          request.resource.data.churchId == resource.data.churchId && 
          request.resource.data.role != 'super_admin' && 
          request.auth.uid != userId
        )
      );

      allow delete: if isSuperAdmin();
    }

    // ── Role Audit Logs ──────────────────────────────────────────────────────
    match /roleAuditLogs/{logId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isRoleAdmin(resource.data.churchId));
      allow create: if isSignedIn();
    }
  }
}
