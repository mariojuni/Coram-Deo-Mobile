rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Require authentication for sermon media
    match /churches/{churchId}/sermons/{sermonId}/media/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Default rule for everything else
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
